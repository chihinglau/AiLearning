# R-02 生产环境变量样例：复制为 deploy/.env 后填写，切勿提交。
# 生成 JWT_SECRET：openssl rand -hex 32

POSTGRES_DB=ailearning
POSTGRES_USER=ailearning
POSTGRES_PASSWORD=
JWT_SECRET=
# 必须是 JSON 数组，且只包含正式域名（禁止 localhost / *）
CORS_ORIGINS=["https://app.example.com"]
# 首次部署或需要补齐内置教材/题库时设为 true，之后保持 false
RUN_SEED=false

# 可选：审计日志留存月数（不得少于 6）
AUDIT_RETENTION_MONTHS=24
