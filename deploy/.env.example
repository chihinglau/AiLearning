# R-02 生产环境变量样例：复制为 deploy/.env 后填写，切勿提交。
# 生成 JWT_SECRET：openssl rand -hex 32

POSTGRES_DB=ailearning
POSTGRES_USER=ailearning
POSTGRES_PASSWORD=
JWT_SECRET=
# 必须是 JSON 数组，且只包含正式域名（禁止 localhost / *）
CORS_ORIGINS=["https://app.example.com"]
# 首次部署或需要补齐内置教材/题库时设为 true，之后保持 false
RUN_SEED=false

# 可选：审计日志留存月数（不得少于 6）
AUDIT_RETENTION_MONTHS=24

# 法务公网地址：商店审核与用户免登录查看隐私政策/用户协议（为空时按请求 Host 推导）
LEGAL_PUBLIC_BASE_URL=https://app.example.com

# R-06 备案与上架信息：取得后回填，App「关于」页与 /api/app/info 展示
APP_DISPLAY_NAME=深爱学
APP_VERSION_LABEL=1.0.0
ICP_RECORD_NO=
APP_RECORD_NO=
SOFTWARE_COPYRIGHT_NO=
SUPPORT_EMAIL=support@ailearning.cn
