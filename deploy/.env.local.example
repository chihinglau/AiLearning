# =================================================================
# AiLearning —— 本地部署环境变量（供 deploy/docker-compose.local.yml）
#
# 复制为 deploy/.env.local 后按需修改；该文件不入库。
# 注意：docker compose 的 ${...} 变量插值读的是 --env-file 指定的文件，
#       env_file: 只把变量灌进容器，二者都要传这一份。
# =================================================================

# ── 数据库 ──
POSTGRES_DB=ailearning
POSTGRES_USER=ailearning
POSTGRES_PASSWORD=change-me-local-pg

# ── 应用 ──
# 本地验证用 local；生产用 production（会强制校验 JWT/CORS 等）
APP_ENV=local
# 至少 32 位，生产必须替换
JWT_SECRET=local-dev-jwt-secret-please-change-0123456789
# 本地 App 走原生 HTTP 客户端，CORS 不参与校验；留通配便于浏览器调试
CORS_ORIGINS=["*"]
# 首次启动灌入底座内容（后续改为受控数据包导入）
RUN_SEED=true

# ── 品牌 / 法务 ──
APP_DISPLAY_NAME=深爱学
SUPPORT_EMAIL=support@ailearning.cn
