# 应用
APP_NAME=AiLearning API
APP_ENV=dev
DEBUG=true
API_V1_PREFIX=/api

# 数据库（PostgreSQL 16）
# 生产示例：postgresql+psycopg://ailearning:password@127.0.0.1:5432/ailearning
DATABASE_URL=sqlite:///./ailearning_dev.db

# 认证
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 合规：儿童账号需家长绑定同意；22:00-06:00 强制休息
STUDY_CURFEW_START=22
STUDY_CURFEW_END=6
DEFAULT_DAILY_LIMIT_MINUTES=120

# CORS（Flutter 客户端 / CMS 后台）
CORS_ORIGINS=http://localhost:3000
